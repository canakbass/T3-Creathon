# Bu dosya bir ORNEKTIR. Bunu ELLE DUZENLEMENIZE GEREK YOK.
# .env git'e commit EDILMEZ (.gitignore'da) - anahtarlariniz repoya sizmaz.
#
# EN KOLAY YOL - repo kokunden tek komut, .env'i hazir olusturur:
#   .venv/bin/python -c "import secrets,pathlib; pathlib.Path('backend/.env').write_text('JWT_SECRET_KEY='+secrets.token_hex(32)+'\n')"
#   (Windows: .venv\Scripts\python ... )
#
# Elle yapmak isterseniz: cp backend/.env.example backend/.env


# === ZORUNLU ===============================================================
# JWT imzalama anahtari. Ayarlanmazsa backend gelistirme icin sabit ve
# GUVENSIZ bir varsayilana doner ve RuntimeWarning basar (bkz. app/auth.py).
#
# DIKKAT: asagiya komutun KENDISINI degil, calistirinca cikan 64 karakterlik
# rastgele degeri yazin. Dogru bicim soyle gorunur (tirnaksiz):
#   JWT_SECRET_KEY=ORNEK00000000000000000000000000000000000000000000000000000ORNEK
#   (yukaridaki SAHTE bir ornektir - buraya asla gercek anahtarinizi yazmayin,
#    bu dosya git'e commit ediliyor)
#
# Uretmek icin (repo kokunden):
#   .venv/bin/python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=


# === ISTEGE BAGLI: AI kriter degerlendirmesi icin LLM ======================
# Bunlari BOS BIRAKIRSANIZ sistem tamamen calisir: kriter degerlendirmesi
# yerel kural motoruyla yapilir ve HICBIR VERI DISARI CIKMAZ.
# Demo icin onerilen budur.
#
# Ayrintili gizlilik uyarisi: ai-scoring/llm.py dosyasinin basi.

# claude | gemini | kural   (bos = kural)
AI_SCORING_LLM=

# --- Gemini kullanacaksaniz ---
# AI Studio'dan aldiginiz anahtar (aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Gemini icin ayrica acik onay gerekiyor. Nedeni:
#
#   UCRETSIZ katmanda Google, gonderdiginiz icerigi urunlerini
#   gelistirmek icin kullaniyor ve insan inceleyicilere aciyor. Kendi
#   kosullari diyor ki: "Do not submit sensitive, confidential, or
#   personal information to the Unpaid Services."
#   (https://ai.google.dev/gemini-api/terms)
#   Creathon sartnamesi ise T3 Vakfi verilerinin ucuncu taraflarla
#   paylasilmamasini sart kosuyor. Bu ikisi CELISIYOR.
#
#   UCRETLI katmanda bu sorun YOK: "Google doesn't use your prompts or
#   responses to improve our products." Ayarlanacak bir sey de yok,
#   otomatik.
#
# DIKKAT - "ucretli" olmak icin Google One AI Premium / Gemini Advanced
# aboneligi YETMEZ. API anahtarinizin bagli oldugu Google Cloud projesine
# Cloud Billing baglamaniz gerekiyor. Hangi katmanda oldugunuzu
# aistudio.google.com -> Projects sayfasindaki "Billing Tier" sutunundan
# gorebilirsiniz.
AI_SCORING_LLM_ONAY=

# Model adi (bos = saglayiciya gore varsayilan)
#   Gemini varsayilani: gemini-2.5-flash
#   Claude varsayilani: claude-opus-5
AI_SCORING_MODEL=

# --- Claude kullanacaksaniz ---
# ANTHROPIC_API_KEY=


# === ISTEGE BAGLI: Supabase (Postgres + Storage) ==========================
# Bunlari BOS BIRAKIRSANIZ sistem tamamen calisir: veri tabani SQLite,
# dosyalar yerel diskte (backend/uploads). Yerel gelistirme icin onerilen.
#
# Supabase'e gecmek YAYINA ALMAK icin gerekli: ucretsiz barindirma
# katmanlarinda (Render/Railway) dosya sistemi GECICIDIR - her yeniden
# dagitimda yuklenen tum raporlar silinir.

# --- Veri tabani ---
# Supabase panosu -> Connect -> Session pooler adresini OLDUGU GIBI kopyalayin.
# Ornek bicim (bolge/shard numarasi projeye gore DEGISIR, tahmin etmeyin):
#   postgresql+psycopg2://postgres.<PROJE_REF>:<SIFRE>@aws-0-<bolge>.pooler.supabase.com:5432/postgres
#
# NEDEN "Session pooler": Direct connection ucretsiz katmanda IPv6-only,
# Transaction pooler (:6543) ise SQLAlchemy'nin oturum durumunu bozuyor.
#
# Sifredeki ozel karakterleri yuzde-kodlayin (@ -> %40), yoksa adres bozulur.
# Bu sifre, asagidaki anahtarlardan FARKLIDIR (Settings -> Database).
DATABASE_URL=

# --- Dosya depolama ---
SUPABASE_URL=
# !!! GIZLI !!! Bu anahtar RLS'i BYPASS eder ve projedeki her tabloya/
# bucket'a tam erisim verir. ASLA tarayiciya gonderilmemeli, ASLA
# NEXT_PUBLIC_ oneki ile kullanilmamali, ASLA commit'lenmemeli.
# Panoda: Settings -> API -> secret/service_role
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=reports

# --- Yayina alirken ---
# Virgulle ayrilmis izinli origin listesi. Vercel adresinizi ekleyin.
# DIKKAT: HTTPS bir sayfa, HTTP bir backend'e istek ATAMAZ (karisik icerik
# engeli) - dagitimda backend de HTTPS olmali.
CORS_ORIGINS=http://localhost:3000

# --- E-posta gönderimi ----------------------------------------------------
#
# Kendi kendine kayıt, e-posta doğrulama ve şifre sıfırlama bu ayarları
# kullanıyor. HEPSİ BOŞ BIRAKILABİLİR: varsayılan `file` arka ucu mektupları
# backend/outbox/*.eml olarak diske yazar ve akış birebir gerçek çalışır
# (jeton üretilir, özeti saklanır, süresi işler, bağlantı tıklanır).
# Demoda outbox dosyasını açıp bağlantıyı kopyalayın.
#
# Üretimde EMAIL_BACKEND=smtp yapıp aşağıdakileri doldurun; KOD DEĞİŞMEZ.
# Gmail uygulama şifresi, Resend, Brevo hepsi aynı değişkenlerle takılır.
EMAIL_BACKEND=file          # file | console | smtp
APP_BASE_URL=http://localhost:3000
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=hesap@ornek.com
# SMTP_PASSWORD=uygulama-sifresi
# SMTP_STARTTLS=1
# SMTP_FROM=no-reply@ornek.com

# Doğrulama jetonunu API yanıtında gösterir - YALNIZCA GELİŞTİRME.
# Açık kalırsa e-posta doğrulama tamamen anlamsızlaşır: kayıt olan kişi
# kendi jetonunu görür, yani "bu kutunun sahibi misin" sorusunu kendi
# kendine cevaplar. EMAIL_BACKEND=smtp iken zaten çalışmaz.
DEV_EXPOSE_EMAIL_TOKEN=0

# Kendi kendine kayıt. Varsayılan AÇIK: kayıt artık hiçbir rol ve hiçbir
# kurum vermiyor, takım bağı yalnızca e-posta doğrulandığında kuruluyor.
# Kuruma kapalı kurulumlar için 0 yapılabilir.
SELF_REGISTRATION=1
