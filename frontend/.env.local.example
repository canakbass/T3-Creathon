# Backend adresi. Bu dosyayi .env.local olarak kopyalayin.
# uvicorn varsayilani 8000; backend'i baska bir portta calistiriyorsaniz
# burayi guncelleyin.
#
# ONEMLI: backend CORS'ta yalnizca http://localhost:3000 adresine izin
# veriyor (bkz. backend/main.py allow_origins). Frontend'i baska bir
# porttan servis ediyorsaniz orayi da guncellemeniz gerekir.
NEXT_PUBLIC_API_URL=http://localhost:8000
